# ==========================================
# Aarogya Drishti Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=development
PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001/api/v1

# Security & Tokens
JWT_SECRET_KEY=change_me_super_secure_random_key_64_bytes_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aarogya_drishti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# Object Storage (Encrypted Private S3/GCS)
STORAGE_BUCKET_NAME=aarogya-drishti-clinical-vault
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_iam_access_key
STORAGE_SECRET_KEY=your_iam_secret_key

# AI Inference Service
AI_MODEL_VERSION=AD-OralNet-v2.4.1
AI_INFERENCE_TIMEOUT_SECONDS=15
ENABLE_DEMONSTRATION_MODE=true

# National Helplines
CANCER_HELPLINE_TOLL_FREE=1800-22-1951
